# Telegram bot token from @BotFather (keep private)
BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN

# TMDB API credentials. Prefer the Read Access Token (Bearer token).
TMDB_READ_ACCESS_TOKEN=PASTE_YOUR_TMDB_READ_ACCESS_TOKEN
# Alternative: use TMDB_API_KEY if you do not have a Read Access Token.
# TMDB_API_KEY=PASTE_YOUR_TMDB_API_KEY

# OTTGuild movie listing/search URL. {query} is URL encoded; {slug} is a simple title slug.
MOVIE_SITE_URL_TEMPLATE=https://ottguild.online/movies/?s={query}

# Language for TMDB data and poster resolution.
TMDB_LANGUAGE=en-US
TMDB_IMAGE_SIZE=w500

# Render webhook settings. Leave WEBHOOK_URL blank on Render if RENDER_EXTERNAL_URL is provided.
# For local polling, run: python polling.py
WEBHOOK_URL=
# A random secret string (A-Z, a-z, 0-9, underscore, hyphen; 1-256 characters).
WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional comma-separated Telegram numeric user IDs for /status.
ADMIN_IDS=

LOG_LEVEL=INFO

# Shared secret used by the companion WordPress status plugin
STATUS_API_KEY=replace-with-a-long-random-secret
